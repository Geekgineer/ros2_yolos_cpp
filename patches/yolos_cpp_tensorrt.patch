 namespace yolos {
 
+// ============================================================================
+// TensorRT execution provider settings
+// ============================================================================
+
+/// @brief Settings of the TensorRT execution provider. Sessions created with useGPU try it first when enabled and
+/// ONNX Runtime provides it, with CUDA as fallback for the nodes TensorRT does not support.
+struct TensorRTOptions {
+    bool enable{false};
+    bool fp16{true};
+    /// Directory for the engine and timing caches. Building an engine takes minutes on a Jetson, a cache makes
+    /// later starts load it in seconds. Empty: no cache.
+    std::string cachePath;
+};
+
+/// @brief Process-wide TensorRT settings, used by every session created afterwards
+inline TensorRTOptions& tensorRTOptions() {
+    static TensorRTOptions options;
+    return options;
+}
+
